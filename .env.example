APP_NAME=TruckBill
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Supported engines: pgsql (default) and mysql (8.x). Soft-delete uniqueness,
# nullable scope keys, and CHECK constraints are driver-aware via SoftDeleteUniqueIndex.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=nexus
DB_USERNAME=nexus_user
DB_PASSWORD=
# MySQL example:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=truckbill
# DB_USERNAME=truckbill
# DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Private file foundation (ADR-008 / WS-5).
# Local/test may use: pass | fake | reject.
# Production must NOT use pass/fake/reject — set an approved driver after PO-P1-DEPS, or uploads fail closed.
FILES_DISK=private_files
FILES_SCANNER=pass

VITE_APP_NAME="${APP_NAME}"

# Opt-in local demo workspace (never used by DatabaseSeeder; blocked outside local/testing).
# LOCAL_DEMO_PASSWORD=
# LOCAL_DEMO_PROFILE=standard
# php artisan db:seed --class=LocalDemoWorkspaceSeeder
# See docs/engineering/LOCAL_DEMO_DATA_SETUP.md

# Initial Internal Team Super Admin (DatabaseSeeder → InternalSuperAdminSeeder).
# Required only when no active Internal Super Admin exists yet.
# Never commit real credentials. Seeder will not reset an existing Super Admin password.
# INTERNAL_SUPER_ADMIN_NAME="Super Admin"
# INTERNAL_SUPER_ADMIN_EMAIL=
# INTERNAL_SUPER_ADMIN_PASSWORD=

# Razorpay Test Mode (PO-P3-PAY-TEST / official PHP SDK). Never commit real secrets.
# Only these three variables are used. Gateway selection is automatic from APP_ENV + Key ID prefix.
# Production Razorpay remains blocked until PO-P3-PAY-PROD.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
